PORT=4000
# Local dev: run a Postgres container, e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zucchini?schema=public"
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-key
CORS_ORIGIN=http://localhost:5173

# On Render: DATABASE_URL is injected automatically when you link a Render Postgres
# instance in render.yaml (or the dashboard). Set the JWT_*, TOKEN_ENCRYPTION_KEY and
# CORS_ORIGIN values as real secrets/values in the Render dashboard — never commit them.
