# ========================================
# Easybox Rider App - Environment Config
# ========================================

# API Configuration
# Backend API URL - Update with your backend domain
EXPO_PUBLIC_API_BASE_URL=https://zucchini-backend.onrender.com

# Socket.io Configuration
# Real-time server URL - Must match backend
EXPO_PUBLIC_SOCKET_URL=https://zucchini-backend.onrender.com

# Location Update Interval (milliseconds)
# How often to send location updates to backend (default: 10 seconds)
EXPO_PUBLIC_LOCATION_UPDATE_INTERVAL_MS=10000

# App Environment
EXPO_PUBLIC_APP_ENV=development

# Feature Flags
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_LOCATION_TRACKING=true
EXPO_PUBLIC_ENABLE_PHOTO_PROOF=true

# Google Maps API Key (optional - for enhanced mapping)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Sentry Error Tracking (optional)
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Build Configuration
EXPO_PUBLIC_BUILD_VERSION=1.0.0
EXPO_PUBLIC_BUILD_TYPE=preview

# Logging
EXPO_PUBLIC_LOG_LEVEL=debug
